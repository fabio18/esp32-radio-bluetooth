  (text "NOTAS:\n1. SN74HCT125 (DIP-14) - Quad Buffer 3-State\n2. Todas ~OE -> GND (saidas habilitadas)\n3. Canal 1: GPIO13 -> 1A -> 1Y -> 100R -> WS2812B\n4. Canais 2-4: Nao conectados (reserva)\n5. C1: 100nF bypass entre VCC e GND\n6. C2: 1000uF bulk perto da fita LED\n7. Resistor 62-100 Ohm no DIN do WS2812B" (at 78.74 157.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b3a5acb3-f007-4226-993a-c0abcf0817f6"))
  (text "J1 (ESP32):\nPin1=GPIO13\nPin2=3.3V\nPin3=5V\nPin4=GND" (at 55.88 91.44 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e5f9fee2-920b-4b36-a705-98db4a13baca"))
  (text "J2 (WS2812B):\nPin1=DIN\nPin2=VCC\nPin3=GND" (at 228.6 91.44 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6babf4ba-b371-4221-a15c-0d287a78fc9e"))

